{
  "info": {
    "_postman_id": "e0f3f3a5-52a5-49d0-aa1d-c611334563c7",
    "name": "Hash Service - Comprehensive Lifecycle & Telemetry Suite",
    "description": "Suite E2E abrangente para o Hash Token Registry Service Domain (BIAN-aligned, ADR-013). Valida o ciclo de vida completo sob /hash-token-registry/v1 (initiate, retrieve, control/deactivate|reactivate|revoke), sanitização de payload (Convenção B), busca multi-dimensional, listagem por status, trilha de auditoria, testes negativos e injeção automática de Trace ID para correlação de logs MDC.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "39879181"
  },
  "item": [
    {
      "name": "00. Infrastructure & Telemetry",
      "item": [
        {
          "name": "Health Check (Kubernetes Probes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Global Health is UP\", () => pm.expect(jsonData.status).to.eql('UP'));",
                  "pm.test(\"MongoDB Component is UP\", () => {",
                  "    pm.expect(jsonData.details.mongodb).to.not.be.undefined;",
                  "    pm.expect(jsonData.details.mongodb.status).to.eql('UP');",
                  "});",
                  "pm.test(\"External Endpoints Component is UP\", () => {",
                  "    pm.expect(jsonData.details['external-endpoints']).to.not.be.undefined;",
                  "    pm.expect(jsonData.details['external-endpoints'].status).to.eql('UP');",
                  "    pm.expect(jsonData.details['external-endpoints'].details.resolvedIpAddress).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01. Lifecycle Scenarios (BIAN Behavior Qualifiers)",
      "item": [
        {
          "name": "01. Initiate Hash (SHA_256)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const jsonData = pm.response.json();",
                  "pm.environment.set(\"hashId\", jsonData.id);",
                  "pm.test(\"Contract: ID and generatedHash are present\", () => {",
                  "    pm.expect(jsonData.id).to.not.be.undefined;",
                  "    pm.expect(jsonData.generatedHash).to.not.be.undefined;",
                  "});",
                  "pm.test(\"Contract: Status is ACTIVE\", () => pm.expect(jsonData.status).to.eql(\"ACTIVE\"));",
                  "pm.test(\"Algorithm matches SHA_256\", () => pm.expect(jsonData.algorithm).to.eql(\"SHA_256\"));",
                  "pm.test(\"Contract: sourceService echoes X-Source-Service header\", () => pm.expect(jsonData.sourceService).to.eql(\"mobile-app\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Source-Service", "value": "mobile-app" },
              { "key": "X-Executor", "value": "{{executor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"payload\": \"  dado-de-teste-sha256-{{$randomAlphaNumeric}}  \",\n    \"algorithm\": \"SHA_256\",\n    \"asSerialKey\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/initiate",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "initiate"]
            }
          },
          "response": []
        },
        {
          "name": "02. Retrieve Hash By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ID matches environment\", () => pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"hashId\")));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/{{hashId}}/retrieve",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "{{hashId}}", "retrieve"]
            }
          },
          "response": []
        },
        {
          "name": "03. Retrieve Tenant Hashes (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns paginated content array\", () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(Array.isArray(res.content) ? res.content : res).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/retrieve?page=0&size=20&status=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "retrieve"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "04. Search Hashes by Source Service (Convention B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns paginated content array\", () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(Array.isArray(res.content) ? res.content : res).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/retrieve/search?sourceService=mobile-app&status=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "retrieve", "search"],
              "query": [
                { "key": "sourceService", "value": "mobile-app" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "05. Retrieve Hashes By Status (Convention B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"All returned items are ACTIVE\", () => {",
                  "    const items = Array.isArray(res.content) ? res.content : res;",
                  "    items.forEach(item => pm.expect(item.status).to.eql(\"ACTIVE\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/status/ACTIVE/retrieve",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "status", "ACTIVE", "retrieve"]
            }
          },
          "response": []
        },
        {
          "name": "06. Control: Deactivate Hash",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status updated to INACTIVE\", () => pm.expect(pm.response.json().status).to.eql(\"INACTIVE\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Executor", "value": "{{executor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Manutenção programada e suspensão temporária\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/{{hashId}}/control/deactivate",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "{{hashId}}", "control", "deactivate"]
            }
          },
          "response": []
        },
        {
          "name": "07. Control: Reactivate Hash",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status restored to ACTIVE\", () => pm.expect(pm.response.json().status).to.eql(\"ACTIVE\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Executor", "value": "{{executor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Retorno à operação regulamentar\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/{{hashId}}/control/reactivate",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "{{hashId}}", "control", "reactivate"]
            }
          },
          "response": []
        },
        {
          "name": "08. Retrieve Forensic Audit Trail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const logs = pm.response.json();",
                  "pm.test(\"Contains at least 3 audit events (Created, Deactivated, Reactivated)\", () => pm.expect(logs.length).to.be.at.least(3));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/{{hashId}}/audit-log/retrieve",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "{{hashId}}", "audit-log", "retrieve"]
            }
          },
          "response": []
        },
        {
          "name": "09. Retrieve 360° Full Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Contains consolidated hash + auditLogs\", () => {",
                  "    pm.expect(json.hash).to.not.be.undefined;",
                  "    pm.expect(json.auditLogs).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/{{hashId}}/full-profile/retrieve",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "{{hashId}}", "full-profile", "retrieve"]
            }
          },
          "response": []
        },
        {
          "name": "10. Control: Revoke Hash (Terminal State)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is REVOKED\", () => pm.expect(pm.response.json().status).to.eql(\"REVOKED\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Executor", "value": "{{executor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Comprometimento crítico de segurança detectado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/{{hashId}}/control/revoke",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "{{hashId}}", "control", "revoke"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Negative Testing (Resilience)",
      "item": [
        {
          "name": "11. Error: Validation Failure (Missing X-Tenant-Id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400 Bad Request\", () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/retrieve",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "retrieve"]
            }
          },
          "response": []
        },
        {
          "name": "12. Error: Hash Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"RFC 7807 error_code is ERR-HASH-00404\", () => pm.expect(pm.response.json().error_code).to.eql(\"ERR-HASH-00404\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/00000000-0000-0000-0000-000000000000/retrieve",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "00000000-0000-0000-0000-000000000000", "retrieve"]
            }
          },
          "response": []
        },
        {
          "name": "13. Error: Reactivate REVOKED Hash (Terminal State Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"RFC 7807 error_code is ERR-HASH-00409\", () => pm.expect(pm.response.json().error_code).to.eql(\"ERR-HASH-00409\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Executor", "value": "hacker" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Tentando reativar item revogado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/{{hashId}}/control/reactivate",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "{{hashId}}", "control", "reactivate"]
            }
          },
          "response": []
        },
        {
          "name": "14. Error: Missing X-Executor Header on Control",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400 Bad Request\", () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Missing executor header on purpose\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/hash-token-registry/v1/{{hashId}}/control/deactivate",
              "host": ["{{base_url}}"],
              "path": ["hash-token-registry", "v1", "{{hashId}}", "control", "deactivate"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// [COLLECTION LEVEL] Auto-inject Trace ID in all requests for MDC correlation",
          "const traceId = pm.variables.replaceIn('{{$guid}}');",
          "pm.request.headers.add({ key: 'X-Trace-Id', value: traceId });",
          "pm.variables.set('currentTraceId', traceId);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// [COLLECTION LEVEL] Global Assertions",
          "pm.test(\"Response time is acceptable (< 1000ms)\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ]
}
